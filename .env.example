# 금융감독원 OpenDART에서 발급받은 인증키입니다.
# 저장소에 실제 키를 커밋하지 마세요.
DART_API_KEY=

# SEC 자동접근 정책에 따라 애플리케이션과 연락처를 식별하는 User-Agent를 사용합니다.
# 예: Research your-email@example.com
SEC_USER_AGENT=

# 역사 listing universe와 소규모 point-in-time 가격 replay에 사용합니다.
# 전체시장 장기 replay는 bulk CSV/CRSP급 데이터를 권장합니다.
# 저장소에 실제 키를 커밋하지 마세요.
ALPHA_VANTAGE_API_KEY=
